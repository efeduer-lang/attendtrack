// Prisma Schema for School Attendance System
// Ready for PostgreSQL, SQLite, MySQL, or Supabase

datasource db {
  provider = "sqlite" // Change to "postgresql" or "mysql" for production deployment
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Gender {
  Male
  Female
  Other
}

enum AttendanceStatus {
  Present
  Absent
  Late
  Excused
}

model SchoolClass {
  id        String       @id @default(cuid())
  name      String       @unique
  teacher   String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  students  Student[]
  records   Attendance[]

  @@map("classes")
}

model Student {
  id        String       @id @default(cuid())
  studentId String       @unique
  name      String
  gender    Gender       @default(Other)
  classId   String
  class     SchoolClass  @relation(fields: [classId], references: [id], onDelete: Restrict)
  records   Attendance[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([classId])
  @@map("students")
}

model Attendance {
  id        String           @id @default(cuid())
  date      String // Format: YYYY-MM-DD
  status    AttendanceStatus @default(Present)
  studentId String
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId   String
  class     SchoolClass      @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([date, studentId, classId])
  @@index([date, classId])
  @@map("attendance")
}

model SchoolSettings {
  id              String   @id @default("default")
  schoolName      String   @default("AttendTrack Academy")
  academicSession String   @default("2026/2027")
  term            String   @default("First Term")
  updatedAt       DateTime @updatedAt

  @@map("school_settings")
}
